-- ─── Helpers ─────────────────────────────────────
local function makeCard(parent, y, h, col)
    col = col or BG_SURFACE
    local f = Instance.new("Frame", parent)
    f.Size             = UDim2.new(1, 0, 0, h)
    f.Position         = UDim2.new(0, 0, 0, y)
    f.BackgroundColor3 = col
    f.BorderSizePixel  = 0
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)
    local s = Instance.new("UIStroke", f)
    s.Color       = BORDER_COL
    s.Thickness   = 1
    s.Transparency = 0.55
    return f
end

local function makeFluentBtn(parent, y, text, bg, sc)
    local b = Instance.new("TextButton", parent)
    b.Size             = UDim2.new(1, 0, 0, 40)
    b.Position         = UDim2.new(0, 0, 0, y)
    b.BackgroundColor3 = bg
    b.Text             = text
    b.TextColor3       = TEXT_PRI
    b.Font             = Enum.Font.GothamBold
    b.TextSize         = 13
    b.AutoButtonColor  = false
    b.Active           = true
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    local s = Instance.new("UIStroke", b)
    s.Color       = sc
    s.Thickness   = 1.5
    s.Transparency = 0.3
    b.MouseEnter:Connect(function()
        TweenService:Create(s, TweenInfo.new(0.15), {Thickness = 2.2, Transparency = 0}):Play()
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundTransparency = 0.08}):Play()
    end)
    b.MouseLeave:Connect(function()
        TweenService:Create(s, TweenInfo.new(0.15), {Thickness = 1.5, Transparency = 0.3}):Play()
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundTransparency = 0}):Play()
    end)
    return b, s
end

local function makeSectionLabel(parent, y, text)
    local l = Instance.new("TextLabel", parent)
    l.Size               = UDim2.new(1, 0, 0, 16)
    l.Position           = UDim2.new(0, 0, 0, y)
    l.BackgroundTransparency = 1
    l.Text               = text
    l.TextColor3         = TEXT_MUT
    l.Font               = Enum.Font.GothamBold
    l.TextSize           = 11
    l.TextXAlignment     = Enum.TextXAlignment.Left
    return l
end

local function makeDescLabel(parent, y, h, text)
    local card = makeCard(parent, y, h)
    local p = Instance.new("UIPadding", card)
    p.PaddingLeft  = UDim.new(0, 8)
    p.PaddingRight = UDim.new(0, 8)
    p.PaddingTop   = UDim.new(0, 4)
    local l = Instance.new("TextLabel", card)
    l.Size               = UDim2.new(1, 0, 1, 0)
    l.BackgroundTransparency = 1
    l.Text               = text
    l.TextColor3         = TEXT_SEC
    l.Font               = Enum.Font.Gotham
    l.TextSize           = 11
    l.TextWrapped        = true
    l.TextXAlignment     = Enum.TextXAlignment.Left
    l.TextYAlignment     = Enum.TextYAlignment.Top
    return l
end

