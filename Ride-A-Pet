local function zeroVel(p)
    if not p then return end
    pcall(function()
        p.AssemblyLinearVelocity = Vector3.zero; p.AssemblyAngularVelocity = Vector3.zero
        p.Velocity = Vector3.zero;               p.RotVelocity = Vector3.zero
    end)
end

local function findBase()
    local plots = workspace:FindFirstChild("Plots")
    if plots then
        for _, plot in ipairs(plots:GetChildren()) do
            local own = (plot:FindFirstChild("Data") or plot):FindFirstChild("Owner")
            if own and (own.Value==LocalPlayer or tostring(own.Value)==tostring(LocalPlayer.UserId) or tostring(own.Value)==LocalPlayer.Name) then
                local b = plot:FindFirstChild("Baseplate") or plot:FindFirstChildWhichIsA("BasePart")
                if b then return CFrame.new(b.Position+Vector3.new(0,5,0)) end
            end
            if norm(plot.Name)==norm(LocalPlayer.Name) or norm(plot.Name)==norm(LocalPlayer.DisplayName) then
                local b = plot:FindFirstChild("Baseplate") or plot:FindFirstChildWhichIsA("BasePart")
                if b then return CFrame.new(b.Position+Vector3.new(0,5,0)) end
            end
        end
    end
    local d = workspace:FindFirstChild(LocalPlayer.Name) or workspace:FindFirstChild(LocalPlayer.DisplayName)
    if d then
        local p = d:FindFirstChildWhichIsA("BasePart")
        if p then return CFrame.new(p.Position+Vector3.new(0,5,0)) end
    end
    for _, fn in ipairs({"Plot","Bases","Base","Players","PlayerPlots","Ranches"}) do
        local f = workspace:FindFirstChild(fn)
        if f then
            for _, ch in ipairs(f:GetChildren()) do
                if norm(ch.Name)==norm(LocalPlayer.Name) or norm(ch.Name)==norm(LocalPlayer.DisplayName) then
                    local p = ch:FindFirstChildWhichIsA("BasePart")
                    if p then return CFrame.new(p.Position+Vector3.new(0,5,0)) end
                end
            end
        end
    end
end

-- ===================== EGG SCANNER — fixed ownership + prompt validity =====================
local function isOwned(egg)
    local check = egg
    while check and check ~= workspace do
        local cn = norm(check.Name)
        if cn:find("rancho") or cn:find("ranch") or cn:find("plot") or cn:find("farm") or cn:find("base") then
            return true
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            if cn == norm(plr.Name) or cn == norm(plr.DisplayName) then
                return true
            end
        end
        -- also check Owner values
        local own = check:FindFirstChild("Owner") or (check:FindFirstChild("Data") and check.Data:FindFirstChild("Owner"))
        if own then
            local v = own.Value
            if v == LocalPlayer or tostring(v) == tostring(LocalPlayer.UserId) or tostring(v) == LocalPlayer.Name then
                return true
            end
            for _, plr in ipairs(Players:GetPlayers()) do
                if v == plr or tostring(v) == tostring(plr.UserId) or tostring(v) == plr.Name then
                    return true
                end
            end
        end
        check = check.Parent
    end
    return false
end

local function scanEggs()
    local results, seen = {}, {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector")) and obj.Parent then
            local egg, parent = nil, obj.Parent
            while parent and parent ~= workspace do
                local n = norm(parent.Name)
                if (parent:IsA("Model") or parent:IsA("BasePart")) and
                   (n:find("huevo") or n:find("egg")) and
                   not (n:find("tracker") or n:find("canasta") or n:find("tool") or n:find("guia") or n:find("guide") or n:find("radar")) then
                    egg = parent
                    break
                end
                parent = parent.Parent
            end
            if egg and not seen[egg] and not isOwned(egg) then
                seen[egg] = true
                local info = detectEgg(egg)
                table.insert(results, {
                    model = egg,
                    prompt = obj,
                    name = info.name,
                    luck = info.luck,
                    rarityRank = info.rarityRank,
                    rarityLabel = info.rarityLabel,
                    rarityColor = info.rarityColor,
                })
            end
        end
    end
    -- Primary sort: highest rarity rank, then highest luck
    table.sort(results, function(a,b)
        if a.rarityRank ~= b.rarityRank then return a.rarityRank > b.rarityRank end
        return (a.luck or 0) > (b.luck or 0)
    end)
    return results, results
end

