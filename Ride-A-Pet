local function norm(s)
    return tostring(s or ""):lower()
        :gsub("á","a"):gsub("é","e"):gsub("í","i"):gsub("ó","o"):gsub("ú","u"):gsub("ñ","n")
        :gsub("%s+"," ")
end

local function fmtLuck(v)
    if not v or v <= 0 then return "—" end
    if v >= 1e12 then return string.format("%.1fT", v/1e12)
    elseif v >= 1e9 then return string.format("%.1fB", v/1e9)
    elseif v >= 1e6 then return string.format("%.1fM", v/1e6)
    elseif v >= 1e3 then return string.format("%.0fK", v/1e3)
    else return tostring(math.floor(v)) end
end

-- Intelligent name + rarity detection from model
local function detectEgg(model)
    local bag = {}
    local function push(s)
        if s and s ~= "" then bag[#bag+1] = norm(tostring(s)) end
    end
    push(model.Name)
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextBox") then push(d.Text)
        elseif d:IsA("StringValue") then push(d.Value) end
        if d:IsA("BasePart") then
            for _, g in ipairs(d:GetChildren()) do
                if g:IsA("BillboardGui") or g:IsA("SurfaceGui") then
                    for _, l in ipairs(g:GetDescendants()) do
                        if l:IsA("TextLabel") or l:IsA("TextBox") then push(l.Text) end
                    end
                end
            end
        end
    end
    pcall(function() for _, v2 in pairs(model:GetAttributes()) do push(tostring(v2)) end end)

    local combined = table.concat(bag, " ")
    -- Prefer exact known egg name match
    for name, data in pairs(EGG_DB) do
        if combined:find(name, 1, true) then
            return {
                name = name:gsub("(%a)([%w_']*)", function(f,r) return f:upper()..r end),
                luck = data.luck,
                rarityRank = data.rank,
                rarityLabel = data.label,
                rarityColor = data.color,
            }
        end
    end
    -- Fallback: rarity keyword only
    for _, tier in ipairs(RARITY_TIERS) do
        if combined:find(norm(tier.label), 1, true) then
            return {
                name = model.Name,
                luck = 0,
                rarityRank = tier.rank,
                rarityLabel = tier.label,
                rarityColor = tier.color,
            }
        end
    end
    return {
        name = model.Name,
        luck = 0,
        rarityRank = 1,
        rarityLabel = "Common",
        rarityColor = Color3.fromRGB(180,180,180),
    }
end

