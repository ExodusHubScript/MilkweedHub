local function getTargetPart(e)
    if not e or not e.prompt or not e.prompt.Parent then return nil end
    local p = e.prompt.Parent
    if p:IsA("Attachment") then p = p.Parent end
    if p and p:IsA("BasePart") then return p end
    if e.model then
        if e.model:IsA("BasePart") then return e.model end
        return e.model:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function clearBeam()
    if beam then pcall(function() beam:Destroy() end) beam = nil end
    if att0 then pcall(function() att0:Destroy() end) att0 = nil end
    if att1 then pcall(function() att1:Destroy() end) att1 = nil end
end

local function makeBeam(target)
    clearBeam()
    local r = getRoot()
    if not r or not target or not target.Parent then return end
    att0 = Instance.new("Attachment")
    att0.Parent = r
    att1 = Instance.new("Attachment")
    att1.Parent = target
    beam = Instance.new("Beam")
    beam.Attachment0 = att0
    beam.Attachment1 = att1
    beam.Color = ColorSequence.new(Color3.fromRGB(0,200,255))
    beam.Width0 = 0.12
    beam.Width1 = 0.12
    beam.FaceCamera = true
    beam.LightEmission = 0.6
    beam.Parent = r
end

local function tp(cf)
    local r = getRoot()
    local h = getHum()
    if not r or not h or h.Health <= 0 then return false end
    r.CFrame = cf
    zeroVel(r)
    return true
end

local function stealEgg(entry)
    if stealing or not entry or not entry.model or not entry.model.Parent then return end
    local part = getTargetPart(entry)
    if not part or not part.Parent then return end
    stealing = true

    -- Ultra-fast TP on top of egg
    if not tp(CFrame.new(part.Position + Vector3.new(0, 2.8, 0))) then
        stealing = false
        return
    end

    local prompt = entry.prompt
    if prompt and prompt.Parent then
        -- Instant Proximity upgrade (maxed for speed)
        pcall(function()
            if prompt:IsA("ProximityPrompt") then
                prompt.HoldDuration = 0
                prompt.MaxActivationDistance = 999
                prompt.RequiresLineOfSight = false
                prompt.Enabled = true
            end
        end)
        -- Fire as fast as possible (no artificial waits between fires)
        for _ = 1, 24 do
            pcall(function()
                if prompt:IsA("ProximityPrompt") and fireproximityprompt then
                    fireproximityprompt(prompt, 1) -- 1 = instant
                elseif prompt:IsA("ClickDetector") and fireclickdetector then
                    fireclickdetector(prompt)
                end
            end)
            task.wait(0.008) -- extremely tight loop
        end
    end

    -- Instant return to base
    local b = findBase()
    if b then
        tp(b)
    elseif returnCFrame then
        tp(returnCFrame)
    end
    stealing = false
    lastScan = 0 -- force immediate next-best rarity scan
end

